{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ucos.io/object-types/ucos.compliance.Regulation.schema.json",
  "title": "ucos.compliance.Regulation",
  "description": "Generated by tools/gen_registries.py from spec/capabilities/packs/compliance.core.yaml and constitutions/U67-compliance/constitution.md. Skeleton: the constitution is normative.",
  "allOf": [
    {
      "$ref": "https://schemas.ucos.io/meta/canonical-object.schema.json"
    }
  ],
  "properties": {
    "type": {
      "const": "ucos.compliance.Regulation"
    },
    "attributes": {
      "type": "object",
      "properties": {
        "id": {
          "description": "id (e.g. in-dpdp-2023, pci-dss-4.0.1, soc2-2017-tsc, iso27001-2022, eu-gpsr, in-ecommerce-rules-2020, in-legal-metrology, ae-pdpl, rbi-pa-guidelines, eu-ai-act)"
        },
        "kind": {
          "type": "string",
          "enum": [
            "law",
            "regulation",
            "standard",
            "contractual",
            "voluntary"
          ]
        },
        "issuer": {
          "description": "issuer"
        },
        "jurisdictions": {
          "description": "jurisdictions"
        },
        "version": {
          "description": "version"
        },
        "effectiveFrom": {
          "$ref": "https://schemas.ucos.io/meta/value-types.schema.json#/$defs/TimePoint"
        },
        "sunset": {
          "$ref": "https://schemas.ucos.io/meta/value-types.schema.json#/$defs/TimePoint"
        },
        "source": {
          "description": "source docs"
        },
        "licenceISOTextsAreLicensed": {
          "description": "licence (ISO texts are licensed: store references/summaries, not full text)"
        }
      },
      "additionalProperties": true
    }
  },
  "x-ucos": {
    "universe": "U67-compliance",
    "capability": "compliance.core",
    "phase": 1,
    "spec": "constitutions/U67-compliance/constitution.md",
    "attributesFromSpec": true
  }
}
