  "sslRequired": "none",
  "registrationAllowed": false,
  "webAuthnPolicyPasswordlessRpEntityName": "UCOS dev",
  "webAuthnPolicyPasswordlessUserVerificationRequirement": "required",
  "roles": {
    "realm": [
      {
        "name": "sample-editor"
      },
      {
        "name": "buyer"
      }
    ]
  },
  "clients": [
    {
      "clientId": "ucos-gateway",
      "publicClient": false,
      "secret": "dev-only-not-a-secret",
