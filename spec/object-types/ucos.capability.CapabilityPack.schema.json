{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ucos.io/object-types/ucos.capability.CapabilityPack.schema.json",
  "title": "ucos.capability.CapabilityPack",
  "description": "Generated by tools/gen_registries.py from spec/capabilities/packs/capability.registry.yaml and constitutions/U57-capability/constitution.md. Skeleton: the constitution is normative.",
  "allOf": [
    {
      "$ref": "https://schemas.ucos.io/meta/canonical-object.schema.json"
    }
  ],
  "properties": {
    "type": {
      "const": "ucos.capability.CapabilityPack"
    },
    "attributes": {
      "type": "object",
      "properties": {
        "id": {
          "description": "id"
        },
        "version": {
          "description": "version"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "description": "capabilities: [CapabilityRef]"
          }
        },
        "artifact": {
          "description": "artifact: oci://registry/ucos/packs/<id>@sha256:…"
        },
        "signature": {
          "description": "signature (cosign bundle)"
        },
        "sbom": {
          "description": "sbom (CycloneDX ref)"
        },
        "provenance": {
          "description": "provenance (SLSA v1 in-toto)"
        },
        "runtime": {
          "description": "runtime: {form, image, resources: {cpu, mem}, scaling: {min, max, metric}, ports}"
        },
        "migrations": {
          "type": "array",
          "items": {
            "description": "migrations: [..]"
          }
        },
        "i18nBundles": {
          "type": "array",
          "items": {
            "description": "i18nBundles: [..]"
          }
        },
        "publishedAt": {
          "$ref": "https://schemas.ucos.io/meta/value-types.schema.json#/$defs/TimePoint"
        },
        "revoked": {
          "description": "revoked?: {at: TimePoint, reason, decision}"
        }
      },
      "additionalProperties": true
    }
  },
  "x-ucos": {
    "universe": "U57-capability",
    "capability": "capability.registry",
    "phase": 0,
    "spec": "constitutions/U57-capability/constitution.md",
    "attributesFromSpec": true
  }
