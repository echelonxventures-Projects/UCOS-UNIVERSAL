{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ucos.io/object-types/ucos.comm.Template.schema.json",
  "title": "ucos.comm.Template",
  "description": "Generated by tools/gen_registries.py from spec/capabilities/packs/communication.core.yaml and constitutions/U40-communication/constitution.md. Skeleton: the constitution is normative.",
