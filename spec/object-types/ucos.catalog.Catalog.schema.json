{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ucos.io/object-types/ucos.catalog.Catalog.schema.json",
  "title": "ucos.catalog.Catalog",
  "description": "Generated by tools/gen_registries.py from spec/capabilities/packs/catalog.listing.yaml and constitutions/U21-catalog/constitution.md. Skeleton: the constitution is normative.",
  "allOf": [
    {
      "$ref": "https://schemas.ucos.io/meta/canonical-object.schema.json"
    }
  ],
  "properties": {
    "type": {
      "const": "ucos.catalog.Catalog"
    },
    "attributes": {
      "type": "object",
      "properties": {
        "id": {
          "description": "id"
        },
        "tenant": {
          "description": "tenant"
        },
        "name": {
          "description": "name"
        },
        "scope": {
          "description": "scope: { channels: [..], stores: [..], segments: [..], jurisdictions: [..] }"
        },
        "includeRules": {
          "description": "includeRules: CEL over Listing (e.g. \"listing.category in ['electronics/*'] && listing.seller.standing == 'good'\")"
        },
        "explicit": {
          "type": "array",
          "items": {
            "description": "explicit: [ListingRef]"
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "description": "exclude: [ListingRef]"
          }
        },
        "priceList": {
          "description": "priceList?: PriceListRef (default resolution in U23)"
        },
        "status": {
          "description": "status"
        }
      },
      "additionalProperties": true
    }
  },
  "x-ucos": {
    "universe": "U21-catalog",
    "capability": "catalog.listing",
    "phase": 1,
    "spec": "constitutions/U21-catalog/constitution.md",
    "attributesFromSpec": true
  }
}
