{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ucos.io/object-types/ucos.industry.IndustryTemplate.schema.json",
  "title": "ucos.industry.IndustryTemplate",
  "description": "Generated by tools/gen_registries.py from spec/capabilities/packs/industry.registry.yaml and constitutions/U20-industry/constitution.md. Skeleton: the constitution is normative.",
  "allOf": [
    {
      "$ref": "https://schemas.ucos.io/meta/canonical-object.schema.json"
    }
  ],
  "properties": {
    "type": {
      "const": "ucos.industry.IndustryTemplate"
    },
    "attributes": {
      "type": "object",
      "properties": {
        "id": {
          "description": "id"
        },
        "version": {
          "description": "version: string"
        },
        "name": {
          "$ref": "https://schemas.ucos.io/meta/value-types.schema.json#/$defs/LocalizedText"
        },
        "industryCodes": {
          "type": "array",
          "items": {
            "description": "industryCodes: [{scheme: isic|naics|nace|nic, code}]"
          }
        },
        "platformDefinition": {
          "description": "platformDefinition: object (pre-filled PlatformDefinition)"
        },
        "capabilityBundles": {
          "type": "array",
          "items": {
            "description": "capabilityBundles: [string]"
          }
        },
        "taxonomySubset": {
          "$ref": "https://schemas.ucos.io/meta/value-types.schema.json#/$defs/UGID"
        },
        "workflows": {
          "type": "array",
          "items": {
            "description": "workflows: [string]"
          }
        },
        "compliancePacks": {
          "type": "array",
          "items": {
            "description": "compliancePacks: [string]"
          }
        },
        "uiTemplates": {
          "type": "array",
          "items": {
            "description": "uiTemplates: [string]"
          }
        },
        "seedData": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.ucos.io/meta/value-types.schema.json#/$defs/UGID"
          }
        },
        "publishedAt": {
          "$ref": "https://schemas.ucos.io/meta/value-types.schema.json#/$defs/TimePoint"
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "published",
            "deprecated"
          ]
        }
      },
      "additionalProperties": true
    }
  },
  "x-ucos": {
    "universe": "U20-industry",
    "capability": "industry.registry",
    "phase": 1,
    "spec": "constitutions/U20-industry/constitution.md",
    "attributesFromSpec": true
  }
}
