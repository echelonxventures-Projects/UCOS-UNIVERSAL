{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ucos.io/events/order.order.placed/1.json",
  "title": "order.order.placed",
  "description": "A buyer committed to purchase; emitted once per order (master §15.4).",
  "x-ucos": {
    "category": "domain",
    "handAuthored": true,
    "producer": "order.core"
  },
  "type": "object",
  "required": [
    "orderId",
    "orderNumber",
    "buyer",
    "sellerSplit",
    "total",
    "placedAt"
  ],
  "properties": {
    "orderId": {
      "$ref": "https://schemas.ucos.io/meta/value-types.schema.json#/$defs/UGID"
    },
    "orderNumber": {
      "type": "string"
    },
    "buyer": {
      "$ref": "https://schemas.ucos.io/meta/value-types.schema.json#/$defs/UGID"
    },
    "channel": {
      "type": "string"
    },
    "store": {
      "$ref": "https://schemas.ucos.io/meta/value-types.schema.json#/$defs/UGID"
    },
    "sellerSplit": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "seller",
          "lines",
          "subtotal"
        ],
        "properties": {
          "seller": {
            "$ref": "https://schemas.ucos.io/meta/value-types.schema.json#/$defs/UGID"
          },
          "sellerOrder": {
            "$ref": "https://schemas.ucos.io/meta/value-types.schema.json#/$defs/UGID"
          },
          "lines": {
            "type": "integer"
          },
          "subtotal": {
            "$ref": "https://schemas.ucos.io/meta/value-types.schema.json#/$defs/Money"
          }
        },
        "additionalProperties": false
      }
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "line",
          "unit",
          "quantity",
          "lineTotal"
        ],
        "properties": {
          "line": {
            "$ref": "https://schemas.ucos.io/meta/value-types.schema.json#/$defs/UGID"
          },
          "unit": {
            "$ref": "https://schemas.ucos.io/meta/value-types.schema.json#/$defs/UGID"
          },
          "sku": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "unitPrice": {
            "$ref": "https://schemas.ucos.io/meta/value-types.schema.json#/$defs/Money"
          },
          "lineTotal": {
            "$ref": "https://schemas.ucos.io/meta/value-types.schema.json#/$defs/Money"
          }
        },
        "additionalProperties": false
      }
    },
    "total": {
      "$ref": "https://schemas.ucos.io/meta/value-types.schema.json#/$defs/Money"
    },
    "tax": {
      "$ref": "https://schemas.ucos.io/meta/value-types.schema.json#/$defs/Money"
    },
    "paymentMethod": {
      "type": "string"
    },
    "quoteHash": {
      "type": "string",
      "description": "Signed PriceQuote hash (ORD-L1)"
    },
    "placedAt": {
      "$ref": "https://schemas.ucos.io/meta/value-types.schema.json#/$defs/TimePoint"
    }
  },
  "additionalProperties": false
}
