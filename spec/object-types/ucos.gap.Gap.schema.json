{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ucos.io/object-types/ucos.gap.Gap.schema.json",
  "title": "ucos.gap.Gap",
  "description": "Generated by tools/gen_registries.py from spec/capabilities/packs/gap.core.yaml and constitutions/U75-discovery-gap/constitution.md. Skeleton: the constitution is normative.",
  "allOf": [
    {
      "$ref": "https://schemas.ucos.io/meta/canonical-object.schema.json"
    }
  ],
  "properties": {
    "type": {
      "const": "ucos.gap.Gap"
    },
    "attributes": {
      "type": "object",
      "properties": {
        "id": {
          "description": "id: `GAP-<seq>` + UGID"
        },
        "kind": {
          "description": "kind: GapKind"
        },
        "severity": {
          "description": "severity: Severity (computed)"
        },
        "subject": {
          "description": "subject: Reference (blueprint, PD, tenant, pack, type, cell, control …)"
        },
        "scope": {
          "description": "scope: `{ tenant?, blueprint?, universe? }`"
        },
        "title": {
          "$ref": "https://schemas.ucos.io/meta/value-types.schema.json#/$defs/LocalizedText"
        },
        "explanation": {
          "description": "explanation: `{ rule: RuleRef@v, bindings, premises: [fact ids / derivation refs], plain: LocalizedText }`"
        },
        "fixes": {
          "description": "fixes: Array<FixRef + parameters>"
        },
        "owner": {
          "description": "owner: PartyRef"
        },
        "firstSeen": {
          "$ref": "https://schemas.ucos.io/meta/value-types.schema.json#/$defs/TimePoint"
        },
        "lastSeen": {
          "$ref": "https://schemas.ucos.io/meta/value-types.schema.json#/$defs/TimePoint"
        },
        "status": {
          "description": "status: `open"
        },
        "resolution": {
          "description": "resolution: `{ cause: fixed"
        },
        "waiver": {
          "description": "waiver: WaiverRef"
        },
        "dueBy": {
          "$ref": "https://schemas.ucos.io/meta/value-types.schema.json#/$defs/TimePoint"
        },
        "dedupKey": {
          "description": "dedupKey: hash"
        }
      },
      "additionalProperties": true
    }
  },
  "x-ucos": {
    "universe": "U75-discovery-gap",
    "capability": "gap.core",
    "phase": 0,
    "spec": "constitutions/U75-discovery-gap/constitution.md",
    "attributesFromSpec": true
  }
}
