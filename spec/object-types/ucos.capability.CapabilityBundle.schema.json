{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ucos.io/object-types/ucos.capability.CapabilityBundle.schema.json",
  "title": "ucos.capability.CapabilityBundle",
  "description": "Generated by tools/gen_registries.py from spec/capabilities/packs/capability.registry.yaml and constitutions/U57-capability/constitution.md. Skeleton: the constitution is normative.",
  "allOf": [
    {
      "$ref": "https://schemas.ucos.io/meta/canonical-object.schema.json"
    }
  ],
  "properties": {
    "type": {
      "const": "ucos.capability.CapabilityBundle"
    },
    "attributes": {
      "type": "object",
      "properties": {
        "id": {
          "description": "id"
        },
        "name": {
          "description": "name"
        },
        "purpose": {
          "description": "purpose (e.g. \"Marketplace Starter\")"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "description": "capabilities: [ref@range]"
          }
        },
        "defaultsConfig": {
          "description": "defaultsConfig"
        },
        "industryTemplates": {
          "type": "array",
          "items": {
            "description": "industryTemplates: [..]"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "x-ucos": {
    "universe": "U57-capability",
    "capability": "capability.registry",
    "phase": 0,
    "spec": "constitutions/U57-capability/constitution.md",
    "attributesFromSpec": true
  }
}
