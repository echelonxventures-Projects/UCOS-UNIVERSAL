{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ucos.io/slo/service-level.schema.json",
  "title": "ServiceLevel (U72)",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "service",
    "universe",
    "tier",
    "owner",
    "slos",
    "alerts"
  ],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "ucos.io/v1"
    },
    "kind": {
      "const": "ServiceLevel"
    },
    "service": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "universe": {
      "type": "string",
      "pattern": "^U\\d{2,3}$"
    },
    "tier": {
      "enum": [
        "T0",
        "T1",
        "T2",
        "T3"
      ]
    },
    "owner": {
      "type": "string"
    },
    "phase": {
      "type": "integer"
    },
    "slos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "sli",
          "objective",
          "rollingWindow"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "description": {
            "type": "string"
          },
          "sli": {
            "type": "object",
            "required": [
              "kind",
              "metric"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "availability",
                  "latency",
                  "freshness",
                  "correctness"
                ]
              },
              "metric": {
                "type": "string"
              },
              "thresholdMs": {
                "type": "integer",
                "minimum": 1
              },
              "percentile": {
                "enum": [
                  "p50",
                  "p95",
                  "p99"
                ]
              }
            }
          },
          "objective": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          },
          "rollingWindow": {
            "type": "string",
            "pattern": "^P\\d+D$"
          }
        }
      }
    },
    "alerts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "slo",
          "condition",
          "severity",
          "runbook"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9.-]+$"
          },
          "slo": {
            "type": "string"
          },
          "condition": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "page",
              "ticket"
            ]
          },
          "runbook": {
            "type": "string",
            "pattern": "^docs/runbooks/[a-z0-9-]+\\.md#[a-z0-9-]+$"
          }
        }
      }
    }
  }
}
