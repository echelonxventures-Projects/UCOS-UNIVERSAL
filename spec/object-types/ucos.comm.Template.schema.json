      "const": "ucos.comm.Template"
    },
    "attributes": {
      "type": "object",
      "properties": {
        "id": {
          "description": "id (e.g. order.confirmed)"
        },
        "purpose": {
          "description": "purpose (PurposeRef)"
        },
        "category": {
          "type": "string",
          "enum": [
            "transactional",
            "service",
            "marketing",
            "security"
          ]
        },
        "channelVariants": {
          "description": "channelVariants: {email: {subject, html, text}, sms: {body, dltTemplateId?}, whatsapp: {providerTemplateName, params}, push: {title, body, deeplink}}"
        },
        "locales": {
          "description": "locales (L10n bundles)"
        },
        "variables": {
          "description": "variables schema"
        },
        "version": {
          "description": "version"
        },
        "approvals": {
          "description": "approvals per channel/provider"
        }
      },
      "additionalProperties": true
    }
  },
  "x-ucos": {
    "universe": "U40-communication",
    "capability": "communication.core",
    "phase": 1,
    "spec": "constitutions/U40-communication/constitution.md",
    "attributesFromSpec": true
  }
}
