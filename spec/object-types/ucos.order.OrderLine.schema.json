{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ucos.io/object-types/ucos.order.OrderLine.schema.json",
  "title": "ucos.order.OrderLine",
  "description": "Generated by tools/gen_registries.py from spec/capabilities/packs/order.core.yaml and constitutions/U26-order/constitution.md. Skeleton: the constitution is normative.",
  "allOf": [
    {
      "$ref": "https://schemas.ucos.io/meta/canonical-object.schema.json"
    }
  ],
  "properties": {
    "type": {
      "const": "ucos.order.OrderLine"
    },
    "attributes": {
      "type": "object",
      "properties": {
        "id": {
          "description": "id"
        },
        "unit": {
          "description": "unit: SellableUnitRef"
        },
        "listingSnapshot": {
          "description": "listingSnapshot: {title, sku, gpid, imageRef}"
        },
        "qty": {
          "description": "qty"
        },
        "unitPrice": {
          "$ref": "https://schemas.ucos.io/meta/value-types.schema.json#/$defs/Money"
        },
        "lineDiscounts": {
          "type": "array",
          "items": {
            "description": "lineDiscounts: [...]"
          }
        },
        "tax": {
          "description": "tax: {category, amount, rate refs}"
        },
        "lineTotal": {
          "$ref": "https://schemas.ucos.io/meta/value-types.schema.json#/$defs/Money"
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "allocated",
            "shipped",
            "delivered",
            "cancelled",
            "returned",
            "partially-returned"
          ]
        },
        "returnPolicy": {
          "description": "returnPolicy: {window: Duration (from decision), restockingFee?}"
        }
      },
      "additionalProperties": true
    }
  },
  "x-ucos": {
    "universe": "U26-order",
    "capability": "order.core",
    "phase": 1,
    "spec": "constitutions/U26-order/constitution.md",
    "attributesFromSpec": true
  }
