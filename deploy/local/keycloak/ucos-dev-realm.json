  ],
  "users": [
    {
      "username": "asha",
      "enabled": true,
      "email": "asha@example.com",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "asha-dev-password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "sample-editor"
      ],
      "firstName": "Asha",
      "lastName": "Dev"
    }
  ]
